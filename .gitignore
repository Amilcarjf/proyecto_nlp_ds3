# Bytecode y cache de Python
__pycache__/
*.py[cod]
*.pyo

# Entornos virtuales
venv/
env/
.venv/
ENV/

# Jupyter
.ipynb_checkpoints/

# Datos intermedios: no se versionan, son artefactos de trabajo transitorios
data/interim/*
!data/interim/.gitkeep

# Logs de ejecución
outputs/logs/*
!outputs/logs/.gitkeep

# Variables de entorno / credenciales
.env

# Sistema operativo
.DS_Store
Thumbs.db

# Editores / IDEs
.vscode/
.idea/
